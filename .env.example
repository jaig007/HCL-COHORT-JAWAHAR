# Copy this file to .env and change values as needed.
# .env is ignored by git; never commit real secrets.

# Name shown in the API docs at /docs
APP_NAME=LLM Gateway

# How much the gateway logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path to the models/routing config file (not used yet, comes in a later lab)
MODELS_CONFIG_PATH=config/models.yaml
